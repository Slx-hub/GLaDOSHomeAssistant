[Unit]
Description=Http Bridge to MQTT
After=multi-user.target
# No start rate limit: one crash must not park the unit in "failed" for good.
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=python /home/pi/GLaDOSHomeAssistant/http_bridge.py
User=pi
WorkingDirectory=/home/pi/GLaDOSHomeAssistant/

[Install]
WantedBy=multi-user.target
