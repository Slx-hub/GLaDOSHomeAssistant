# Copy to /etc/meter.env and set mode 0600:
#   sudo cp setup_files/meter.env.example /etc/meter.env
#   sudo chmod 600 /etc/meter.env
#   sudo nano /etc/meter.env
# Never commit the real file.
FRITZBOX_PASSWORD=changeme
# Full ntfy topic URL for failure notifications. The topic name is the
# access credential, so it belongs here and not in meter/config.yaml.
# Leave unset to disable notifications (failures still hit the journal).
NTFY_URL=
